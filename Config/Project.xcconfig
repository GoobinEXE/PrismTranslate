// Shared Xcode settings. Optional local overrides (Team ID) via Secrets.xcconfig at repo root.
#include? "../Secrets.xcconfig"

// Liquid Glass / TranslationSession.isReady — só compila com SDK macOS 26+ (Xcode 26).
// CI com Xcode 16 fica sem a flag e usa fallbacks de material.
SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=macos26*] = $(inherited) PRISM_MACOS26_SDK

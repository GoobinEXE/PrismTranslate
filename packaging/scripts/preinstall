#!/bin/bash
# Confere macOS 15+ antes de copiar o Prism. Não instala Xcode nem CLT.
set -euo pipefail

os_major="$(sw_vers -productVersion | cut -d. -f1)"
if [[ -z "$os_major" || "$os_major" -lt 15 ]]; then
  osascript <<'APPLESCRIPT' || true
display dialog "O Prism precisa do macOS 15 Sequoia ou mais novo.

Não é necessário ter o Xcode instalado." buttons {"OK"} default button 1 with icon stop with title "Prism"
APPLESCRIPT
  exit 1
fi

exit 0

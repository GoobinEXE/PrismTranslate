    },
    "Checks the engine and the “text I write” pair in this window. Does not open the panel, HUD, or fire shortcuts." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valida o motor e o par «texto que escrevo» nesta janela. Não abre o painel, o HUD nem dispara atalhos."
          }
        }
      }
    },
    "Choose the target language. With Apple Translation, packs download now and translation runs on this Mac." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o idioma destino. Com Apple Translation, os pacotes são baixados agora e a tradução roda no aparelho."
          }
        }
      }
    },
    "Classic translation" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradução clássica"
          }

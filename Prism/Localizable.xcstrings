    },
    "The Translate shortcut replaces in place if the field is editable; for read-only text it opens the panel (Copy). Popup mode (opt-in) opens the panel for any selection." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O atalho Traduzir substitui no lugar se o campo for editável; em texto só leitura abre o painel (Copiar). O modo popup (opt-in) abre o painel em qualquer seleção."
          }
        }
      }
    },
    "These are your current shortcuts. You can change them in Settings → Shortcuts." : {

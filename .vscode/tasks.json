{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xcodebuild: Prism (Debug)",
      "type": "shell",
      "command": "/Applications/Xcode.app/Contents/Developer/usr/bin/xcodebuild",
      "args": [
        "-project",
        "Prism.xcodeproj",
        "-scheme",
        "Prism",
        "-configuration",
        "Debug",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "xcodebuild: Prism (Release)",
      "type": "shell",
      "command": "/Applications/Xcode.app/Contents/Developer/usr/bin/xcodebuild",
      "args": [
        "-project",
        "Prism.xcodeproj",
        "-scheme",
        "Prism",
        "-configuration",
        "Release",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
        }
      },
      "group": "build",
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "xcode-build-server: configure",
      "type": "shell",
      "command": "xcode-build-server config -project Prism.xcodeproj -scheme Prism",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer",
          "PATH": "/Applications/Xcode.app/Contents/Developer/usr/bin:${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "open: Xcode",
      "type": "shell",
      "command": "open -a Xcode Prism.xcodeproj",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
